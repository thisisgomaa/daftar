#!/usr/bin/env python3
"""Daftar CLI — Telegram bridge + knowledge memory for Claude Code / Codex."""

from __future__ import annotations

import argparse
import os
import sys
from pathlib import Path

# Allow running from a git checkout without installing
_ROOT = Path(__file__).resolve().parents[1]
if str(_ROOT) not in sys.path:
    sys.path.insert(0, str(_ROOT))


def _apply_profile_from_argv(argv: list[str]) -> list[str]:
    """Pull --profile NAME (or -p NAME) from argv; set DAFTAR_PROFILE."""
    out: list[str] = []
    i = 0
    profile: str | None = None
    while i < len(argv):
        a = argv[i]
        if a == "--profile" and i + 1 < len(argv):
            profile = argv[i + 1]
            i += 2
            continue
        if a.startswith("--profile="):
            profile = a.split("=", 1)[1]
            i += 1
            continue
        out.append(a)
        i += 1
    if profile is not None:
        from daftar.config import set_active_profile

        set_active_profile(profile)
    elif os.environ.get("DAFTAR_PROFILE"):
        from daftar.config import set_active_profile

        set_active_profile(os.environ.get("DAFTAR_PROFILE"))
    return out


def _cmd_setup(_: argparse.Namespace) -> int:
    from daftar.setup import run_setup

    return run_setup()


def _cmd_run(_: argparse.Namespace) -> int:
    from daftar.bridge import run_bridge

    run_bridge()
    return 0


def _cmd_doctor(_: argparse.Namespace) -> int:
    from daftar.doctor import run_doctor

    return run_doctor()


def _cmd_send(args: argparse.Namespace) -> int:
    from daftar.bridge import Bridge
    from daftar.config import load_config

    cfg = load_config()
    bridge = Bridge(cfg)
    path = Path(args.file).expanduser().resolve()
    if not path.exists():
        print(f"File not found: {path}", file=sys.stderr)
        return 1
    # Optional caption file next to dest in outbox, or use caption arg
    outbox = bridge.workspace / "outbox"
    outbox.mkdir(parents=True, exist_ok=True)
    dest = outbox / path.name
    if dest.resolve() != path:
        import shutil

        shutil.copy2(path, dest)
    if args.caption:
        (outbox / (path.name + ".txt")).write_text(args.caption, encoding="utf-8")
    n = bridge.deliver_outbox(once_path=dest)
    print(f"sent {n} file(s)")
    return 0 if n else 1


def _cmd_image(args: argparse.Namespace) -> int:
    from daftar.config import apply_to_environ, load_config
    from daftar.image import main as image_main

    apply_to_environ(load_config())
    argv = ["--prompt", args.prompt, "--out", args.out]
    if args.size:
        argv += ["--size", args.size]
    for ref in args.ref or []:
        argv += ["--ref", ref]
    return image_main(argv)


def _cmd_kb(args: argparse.Namespace) -> int:
    from daftar.config import load_config, workspace_path
    from daftar import kb as kbmod

    try:
        cfg = load_config()
        ws = workspace_path(cfg)
    except Exception:
        ws = None
    return kbmod.main(args.kb_args, workspace=ws)


def _cmd_curator(args: argparse.Namespace) -> int:
    from daftar.config import apply_to_environ, load_config, workspace_path
    from daftar.curator import run_curator

    cfg = load_config()
    apply_to_environ(cfg)
    os.environ.setdefault("CURATOR_MODEL", cfg.get("CURATOR_MODEL") or "opus")
    os.environ.setdefault(
        "CURATOR_FULL_WEEKDAY", cfg.get("CURATOR_FULL_WEEKDAY") or "4"
    )
    return run_curator(
        workspace=workspace_path(cfg),
        dry_run=args.dry_run,
        full=args.full,
        topic=args.topic,
        model=cfg.get("CURATOR_MODEL") or "opus",
    )


def _cmd_service(args: argparse.Namespace) -> int:
    from daftar import service as svc

    if args.service_cmd == "install":
        return svc.install()
    if args.service_cmd == "uninstall":
        return svc.uninstall()
    if args.service_cmd == "status":
        return svc.status()
    print("Usage: daftar service install|uninstall|status")
    return 2


def _cmd_version(_: argparse.Namespace) -> int:
    from daftar import __version__

    print(f"daftar {__version__}")
    return 0


def _cmd_profiles(_: argparse.Namespace) -> int:
    from daftar.config import list_profile_names, load_profile_config
    from daftar import service as svc

    names = list_profile_names()
    if not names:
        print("(no profiles — run `daftar setup`)")
        return 0
    for name in names:
        cfg = load_profile_config(name)
        engine = cfg.get("ENGINE") or "claude"
        bot = cfg.get("BOT_USERNAME") or "-"
        ws = cfg.get("WORKSPACE") or "-"
        st = svc.status_text(name)
        print(f"{name:16} engine={engine:6} @{bot:24} service={st:12} ws={ws}")
    return 0


def _cmd_delegate(args: argparse.Namespace) -> int:
    from daftar.config import active_profile, profile_label
    from daftar import jobs as jobsmod

    brief = args.brief or ""
    if args.brief_file:
        brief = Path(args.brief_file).expanduser().read_text(encoding="utf-8")
    if not brief.strip():
        print("Provide --brief or --brief-file", file=sys.stderr)
        return 2
    attachments = [str(Path(a).expanduser().resolve()) for a in (args.attach or [])]
    for a in attachments:
        if not Path(a).exists():
            print(f"Attachment not found: {a}", file=sys.stderr)
            return 1
    job_id = jobsmod.enqueue(
        args.to,
        title=args.title,
        brief=brief,
        requester=profile_label(active_profile()),
        attachments=attachments,
    )
    print(job_id)
    print(
        "Queued. Do not wait or poll: end your turn now with one line to the owner. "
        "The result will come back to you as a [system] message, and you deliver it then.",
        file=sys.stderr,
    )
    return 0


def _cmd_jobs(args: argparse.Namespace) -> int:
    from daftar.config import set_active_profile
    from daftar import jobs as jobsmod

    if args.profile:
        set_active_profile(args.profile)
    rows = jobsmod.list_jobs(args.profile)
    print(jobsmod.format_jobs_table(rows))
    return 0


def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(
        prog="daftar",
        description="Telegram bridge + long-term memory for Claude Code / Codex",
    )
    p.add_argument("--version", action="store_true", help="print version")
    p.add_argument(
        "--profile",
        default=None,
        help="use named profile (config/state under DAFTAR_HOME/profiles/NAME)",
    )
    sub = p.add_subparsers(dest="command")

    sub.add_parser("setup", help="interactive setup").set_defaults(func=_cmd_setup)
    sub.add_parser("run", help="run the Telegram bridge").set_defaults(func=_cmd_run)
    sub.add_parser("doctor", help="check install health").set_defaults(func=_cmd_doctor)
    sub.add_parser("profiles", help="list bridges/profiles").set_defaults(func=_cmd_profiles)

    sp = sub.add_parser("send", help="send a file to the owner via Telegram")
    sp.add_argument("file")
    sp.add_argument("caption", nargs="?", default="")
    sp.set_defaults(func=_cmd_send)

    ip = sub.add_parser("image", help="generate an image via OpenAI")
    ip.add_argument("--prompt", required=True)
    ip.add_argument("--out", required=True)
    ip.add_argument("--ref", action="append", default=[])
    ip.add_argument("--size", default="1024x1024")
    ip.set_defaults(func=_cmd_image)

    kp = sub.add_parser("kb", help="knowledge base commands")
    kp.add_argument("kb_args", nargs=argparse.REMAINDER)
    kp.set_defaults(func=_cmd_kb)

    cp = sub.add_parser("curator", help="run the knowledge curator")
    cp.add_argument("--dry-run", action="store_true")
    cp.add_argument("--full", action="store_true")
    cp.add_argument("--topic", default=None)
    cp.set_defaults(func=_cmd_curator)

    sv = sub.add_parser("service", help="install/uninstall OS service")
    sv.add_argument("service_cmd", nargs="?", default="status")
    sv.set_defaults(func=_cmd_service)

    dp = sub.add_parser("delegate", help="hand a job to another profile/bridge")
    dp.add_argument("--to", required=True, help="target profile name")
    dp.add_argument("--title", required=True)
    dp.add_argument("--brief", default="")
    dp.add_argument("--brief-file", default="")
    dp.add_argument("--attach", action="append", default=[])
    dp.set_defaults(func=_cmd_delegate)

    jp = sub.add_parser("jobs", help="list queued/running/done jobs")
    jp.add_argument("--profile", default=None, help="profile to inspect")
    jp.set_defaults(func=_cmd_jobs)

    sub.add_parser("version", help="print version").set_defaults(func=_cmd_version)
    return p


def main(argv: list[str] | None = None) -> int:
    raw = list(sys.argv[1:] if argv is None else argv)
    # Allow `daftar --help` and `daftar --version`
    if raw == ["--version"] or raw == ["-V"]:
        return _cmd_version(argparse.Namespace())
    # Apply --profile before importing profile-sensitive modules in subcommands
    raw = _apply_profile_from_argv(raw)
    parser = build_parser()
    if not raw:
        parser.print_help()
        return 0
    args = parser.parse_args(raw)
    # argparse --profile on the parser may also be set if left in argv — already stripped
    if getattr(args, "profile", None) and args.command not in ("jobs",):
        from daftar.config import set_active_profile

        set_active_profile(args.profile)
    if getattr(args, "version", False) and not args.command:
        return _cmd_version(args)
    if not getattr(args, "func", None):
        parser.print_help()
        return 0
    # Strip leading `--` from kb remainder if present
    if args.command == "kb" and args.kb_args[:1] == ["--"]:
        args.kb_args = args.kb_args[1:]
    return int(args.func(args))


if __name__ == "__main__":
    raise SystemExit(main())
